# ---- Frontend (exposed to the browser: publishable values only) ----
# Supabase project URL, e.g. http://127.0.0.1:54321 for the local stack
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon / publishable key (safe for the browser; RLS protects data)
VITE_SUPABASE_ANON_KEY=your-anon-key
# Public site origin used for canonical URLs, sitemap and auth redirects
VITE_SITE_URL=http://localhost:5173

# ---- Server only (Edge Function secrets — set with `supabase secrets set`, never prefix with VITE_) ----
# SUPABASE_SERVICE_ROLE_KEY is injected automatically into Edge Functions by Supabase.
# Comma-separated list of origins allowed to call Edge Functions
ALLOWED_ORIGINS=http://localhost:5173
